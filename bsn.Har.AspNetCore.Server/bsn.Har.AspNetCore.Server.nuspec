			<dependency id="Microsoft.Extensions.Options" version="2.2.0" />
			<dependency id="System.Threading.Tasks.Extensions" version="4.5.4" />
			<dependency id="System.ValueTuple" version="4.5.0" />
		</dependencies>
	</metadata>
	<files>
		<file src="bin\$Configuration$\bsn.Har.AspNetCore.Server.*" target="lib" />
	</files>
</package>
