<package>
	<metadata>
		<id>bsn.Har.AspNetCore.Server</id>
		<version>1.0.0</version>
		<authors>avonwyss</authors>
		<owners>avonwyss</owners>
		<license type="expression">MIT</license>
		<projectUrl>https://github.com/avonwyss/bsn.Har</projectUrl>
		<requireLicenseAcceptance>false</requireLicenseAcceptance>
		<description>.NET Library for implementing a ASP.NET Core server for handling HAR requests and responses</description>
		<copyright>Copyright 2024 Arsène von Wyss</copyright>
		<tags>bsn HAR</tags>
		<dependencies>
			<dependency id="Microsoft.AspNetCore.Hosting.Abstractions" version="2.2.0" />
